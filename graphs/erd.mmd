erDiagram
    direction LR
    USERS {
        uuid id PK
        string username UK "3-32 chars, lowercase"
        string email UK
        string passwordHash "argon2 / bcrypt hash"
        string displayName
        date createdAt
        date updatedAt
    }

    POSTS {
        uuid id PK
        uuid authorId FK "users.id"
        string title
        string slug UK
        string content "markdown"
        date? publishedAt "null until published"
        int likeCount "default 0"
        date createdAt
        date updatedAt
    }

    LIKES {
        uuid id PK
        uuid userId FK "users.id"
        uuid postId FK "posts.id"
        date createdAt
    }

    USERS ||--o{ POSTS : writes
    USERS ||--o{ LIKES : gives
    POSTS ||--o{ LIKES : receives
