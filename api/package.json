{
  "name": "comp3006",
  "version": "1.1.2",
  "description": "This repo contains the source code, documentation and test procedures for all of my (Bobby Mannino) COMP3006 work.",
  "homepage": "https://github.com/bobbymannino/comp3006#readme",
  "bugs": {
    "url": "https://github.com/bobbymannino/comp3006/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bobbymannino/comp3006.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "node --watch index.ts",
    "format": "oxfmt",
    "test": "jest",
    "test:coverage": "npm run test -- --coverage",
    "test:unit": "jest --testPathIgnorePatterns '<rootDir>/api/' '<rootDir>/models.test.ts' '<rootDir>/auth.test.ts'",
    "test:unit:coverage": "npm run test:unit -- --coverage"
  },
  "dependencies": {
    "@node-rs/bcrypt": "^2.0.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mongoose": "^9.12.1",
    "tslog": "^5.5.0",
    "valibot": "^1.5.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@jest/globals": "^30.5.2",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "jest": "^30.5.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2"
  },
  "jest": {
    "collectCoverageFrom": [
      "*.ts",
      "api/*.ts",
      "!**/*.test.ts",
      "!test-utils.ts"
    ],
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "@swc/jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!tslog/)"
    ]
  }
}
